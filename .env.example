# The Possessed Butler - Environment Configuration
# Copy this file to .env.local and configure your settings.
# NEVER commit .env.local or real secrets to Git.

# ── LLM Provider Configuration ───────────────────────────────────────────────
# Supported providers: ollama | mock (planned: gemini | openai)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Agent Execution Limits
AGENT_PROVIDER_TIMEOUT_MS=60000
AGENT_MAX_OUTPUT_TOKENS=1024
AGENT_MAX_INVALID_OUTPUT_RETRIES=2

# ── Gmail / SMTP Configuration ───────────────────────────────────────────────
# For real Gmail delivery, use port 587 with STARTTLS and a 16-character Google App Password:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=The Possessed Butler <your-email@gmail.com>

# For disposable sandbox testing without real sending, use Ethereal (https://ethereal.email):
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_USER=your-ethereal-user
# SMTP_PASS=your-ethereal-pass
# EMAIL_FROM=The Possessed Butler <your-ethereal-user>
