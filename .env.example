# Copy to .env.local and fill in. Never commit real values.
# mock | ollama | gemini | openai   (only mock is implemented so far)
LLM_PROVIDER=mock

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=

AGENT_PROVIDER_TIMEOUT_MS=30000
AGENT_MAX_OUTPUT_TOKENS=1024
AGENT_MAX_INVALID_OUTPUT_RETRIES=1
